{
  "pulse": {
    "window_minutes": 5,
    "flush_interval_seconds": 30,
    "snapshot_cache_seconds": 20,
    "max_users_per_bucket": 5000,
    "retention_hours": 48
  },
  "capacity": {
    "active_users_soft": 250,
    "llm_calls_per_minute_soft": 150,
    "llm_error_ratio_hard": 0.25,
    "llm_rate_limited_ratio_hard": 0.08,
    "llm_latency_ms_soft": 9000
  },
  "levels": [
    {"name": "calm", "below": 0.45},
    {"name": "busy", "below": 0.75},
    {"name": "strained", "below": 0.95},
    {"name": "critical", "below": 1000}
  ],
  "policies": {
    "calm": {
      "memory": {"digest_min_turns": 6, "summary_min_new_digests": 2, "summary_min_new_facts": 3, "user_cooldown_hours": 4, "daily_ai_calls_per_user": 6, "opportunistic": true, "cron_batch": 60, "max_defer_hours": 24},
      "voice_reaction": {"enabled": true, "interval_scale": 1.0},
      "chat": {"history_scale": 1.0},
      "quota": {"anonymous_scale": 1.0}
    },
    "busy": {
      "memory": {"digest_min_turns": 10, "summary_min_new_digests": 3, "summary_min_new_facts": 5, "user_cooldown_hours": 8, "daily_ai_calls_per_user": 4, "opportunistic": true, "cron_batch": 30, "max_defer_hours": 24},
      "voice_reaction": {"enabled": true, "interval_scale": 1.6},
      "chat": {"history_scale": 1.0},
      "quota": {"anonymous_scale": 1.0}
    },
    "strained": {
      "memory": {"digest_min_turns": 16, "summary_min_new_digests": 4, "summary_min_new_facts": 8, "user_cooldown_hours": 16, "daily_ai_calls_per_user": 2, "opportunistic": false, "cron_batch": 10, "max_defer_hours": 36},
      "voice_reaction": {"enabled": true, "interval_scale": 3.0},
      "chat": {"history_scale": 0.8},
      "quota": {"anonymous_scale": 0.6}
    },
    "critical": {
      "memory": {"digest_min_turns": 24, "summary_min_new_digests": 6, "summary_min_new_facts": 12, "user_cooldown_hours": 24, "daily_ai_calls_per_user": 1, "opportunistic": false, "cron_batch": 0, "max_defer_hours": 48},
      "voice_reaction": {"enabled": false, "interval_scale": 6.0},
      "chat": {"history_scale": 0.6},
      "quota": {"anonymous_scale": 0.4}
    }
  },
  "memory": {
    "journal_max_turns": 40,
    "journal_turn_chars": 500,
    "reply_chars": 300,
    "max_digests": 12,
    "digest_max_words": 70,
    "summary_max_words": 90,
    "summary_max_chars": 700,
    "digest_input_chars": 6000,
    "idle_compact_minutes": 30
  }
}
