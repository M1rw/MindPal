{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MindPal API limits configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chat",
    "identity",
    "memory",
    "sessions",
    "release",
    "request",
    "voice",
    "dictation"
  ],
  "properties": {
    "chat": {
      "type": "object"
    },
    "identity": {
      "type": "object"
    },
    "memory": {
      "type": "object"
    },
    "sessions": {
      "type": "object"
    },
    "release": {
      "type": "object"
    },
    "request": {
      "type": "object",
      "required": [
        "max_body_bytes"
      ],
      "properties": {
        "max_body_bytes": {
          "type": "integer",
          "minimum": 65536
        }
      }
    },
    "voice": {
      "type": "object",
      "required": [
        "max_traces_per_session",
        "max_trace_events"
      ],
      "properties": {
        "max_traces_per_session": {
          "type": "integer",
          "minimum": 1
        },
        "max_trace_events": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "dictation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_audio_bytes",
        "per_hour_account",
        "per_hour_guest"
      ],
      "properties": {
        "max_audio_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "per_hour_account": {
          "type": "integer",
          "minimum": 1
        },
        "per_hour_guest": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
