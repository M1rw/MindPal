{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "crons": [
    {
      "path": "/api/internal/voice-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/memory-consolidation",
      "schedule": "30 3 * * *"
    }
  ],
  "framework": "fastapi",
  "installCommand": "python -m pip install --disable-pip-version-check --no-input -r requirements.txt",
  "buildCommand": "python scripts/build/apply_brand.py && npm ci && npm run build:vercel && python scripts/build/verify_frontend_build.py",
  "env": {
    "ENVIRONMENT": "production",
    "DEBUG": "false",
    "MINDPAL_CHAT_PROVIDER": "groq",
    "MINDPAL_JSON_PROVIDER": "groq",
    "MINDPAL_LLM_FALLBACK": "openrouter",
    "MINDPAL_VOICE_CLASSIFIER": "verify",
    "GROQ_MODEL": "qwen/qwen3.8-27b",
    "GROQ_JSON_MODEL": "qwen/qwen3.8-27b",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "OPENROUTER_MODEL": "google/gemma-4-31b-it:free",
    "OPENROUTER_JSON_MODEL": "google/gemma-4-31b-it:free",
    "FIREBASE_PROJECT_ID": "mindpal-official-0",
    "MINDPAL_STORAGE_PROVIDER": "supabase",
    "SUPABASE_URL": "https://ifezhzuwbdurxkpooblh.supabase.co",
    "FIREBASE_APP_NAME": "mindpal",
    "FIREBASE_AUTH_DOMAIN": "mindpal-official-0.firebaseapp.com",
    "FIREBASE_STORAGE_BUCKET": "mindpal-official-0.firebasestorage.app",
    "FIREBASE_MESSAGING_SENDER_ID": "234733155455",
    "FIREBASE_WEB_APP_ID": "1:234733155455:web:a297853f71b6092b0e3b4a",
    "FIREBASE_MEASUREMENT_ID": "G-CT1D5ZNRB8",
    "FIREBASE_WEB_PROJECT_ID": "mindpal-official-0",
    "FIREBASE_WEB_GOOGLE_CLIENT_ID": "234733155455-j0cfkt4hgq4esqaauvro1jmgq81vgcq0.apps.googleusercontent.com",
    "FIREBASE_USE_APPLICATION_DEFAULT": "false",
    "MINDPAL_CORS_ORIGINS": "https://mindpal-demo.vercel.app",
    "PYTHONUNBUFFERED": "1"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(self), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/dist/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
