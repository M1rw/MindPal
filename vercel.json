{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "fastapi",
  "installCommand": "python -m pip install --disable-pip-version-check --no-input -r requirements.txt",
  "buildCommand": "npm ci && npm run build && npm run build:voice-v3-auth && mkdir -p voice-v3/public && cp frontend/dist/voice-v3-auth.bundle.js voice-v3/public/voice-v3-auth.bundle.js && npm --prefix voice-v3 ci && npm --prefix voice-v3 run build && rm -rf frontend/voice-v3 && mkdir -p frontend/voice-v3 && cp -R voice-v3/dist/. frontend/voice-v3/ && python scripts/verify_prebuilt_frontend.py",
  "env": {
    "ENVIRONMENT": "production",
    "DEBUG": "false",
    "ENABLE_DOCS": "false",
    "ENABLE_HSTS": "true",
    "FIREBASE_USE_APPLICATION_DEFAULT": "false",
    "FIREBASE_WEB_GOOGLE_CLIENT_ID": "234733155455-j0cfkt4hgq4esqaauvro1jmgq81vgcq0.apps.googleusercontent.com",
    "FIREBASE_USE_SAME_ORIGIN_AUTH_PROXY": "false",
    "PYTHONUNBUFFERED": "1"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/dist/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/runtime-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
