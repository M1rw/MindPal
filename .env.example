# -----------------------------------------------------------------------------
# MindPal environment
# -----------------------------------------------------------------------------

APP_NAME=MindPal
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
ENABLE_DOCS=true
ENABLE_HSTS=false
APP_URL=http://localhost:8000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

HOST=0.0.0.0
PORT=8000
WORKERS=1

# Host and origin policy. The app and the API share an origin, so a
# single-origin deployment needs neither of these set.
#
# MINDPAL_ALLOWED_HOSTS: comma-separated hostnames this deployment answers to.
# Unset in production logs a warning and accepts any Host header, which lets a
# forged Host poison absolute URLs and anything cached in front of the app.
# MINDPAL_ALLOWED_HOSTS=mindpal.example.com,www.mindpal.example.com
#
# MINDPAL_CORS_ORIGINS: exact origins allowed to call the API cross-site. Only
# needed when the web client is served from a different origin. "*" is refused
# at startup — these endpoints carry Authorization headers, and a wildcard
# invites any page to drive them with a token it has phished.
# MINDPAL_CORS_ORIGINS=https://app.mindpal.example.com

# -----------------------------------------------------------------------------
# Auth/session policy
# -----------------------------------------------------------------------------

# Guests may browse and chat without signing in. They have no server-side
# storage key at all: chats, profile, insights and memory live on their device
# until they sign in. This switch does not change that.
ALLOW_ANONYMOUS_SESSIONS=true

# Live duplex preview. On by default for signed-in accounts. Set to 0 to disable
# (allowlist still works via MINDPAL_VOICE_LIVE_ALLOWLIST). Guests always sign in first.
# MINDPAL_VOICE_LIVE=0
# MINDPAL_VOICE_LIVE_ALLOWLIST=

# Presence surface preview. Off unless explicitly enabled.
# MINDPAL_PRESENCE=1
# MINDPAL_PRESENCE_ALLOWLIST=

# -----------------------------------------------------------------------------
# LLM providers
# Supported: gemini,openrouter,groq
# -----------------------------------------------------------------------------

LLM_PROVIDER_ORDER=gemini,openrouter,groq

GEMINI_API_KEY=
# Chat model. Was previously ignored by the code; it is honoured now, so a stale
# value here (or in .env.local) will actually change which model answers users.
GEMINI_MODEL=gemini-2.5-flash
# Safety classifier + other structured JSON calls. Kept separate on purpose: it is
# a different quota pool, so an exhausted chat quota does not take the live-voice
# crisis classifier down with it. Validate any change with
# scripts/eval/validate_voice_classifier.py before shipping it.
GEMINI_JSON_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=45

# -----------------------------------------------------------------------------
# Text provider routing
#
# Gemini's quota is ONE pool. The only workload that genuinely requires Gemini is
# the Live native-audio socket; chat, the crisis classifier and the call recap are
# ordinary text. Routing text to another provider keeps the whole Gemini
# allocation for Live - and stops a text-quota exhaustion from taking the
# live-voice safety classifier down with it, which is what happened before.
#
#   gemini | openrouter | groq
# Default is gemini everywhere, so this is opt-in.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Live-voice safety: two detectors, one state machine
#
# in-band   The Live model rates the caller itself via the `report_risk` tool.
#           Hears prosody, crying, hesitation - none of which survives ASR - and
#           costs no latency or quota. Always on. NOT independent: the model
#           grading the call is the model running it.
# classifier An independent Gemini/OpenRouter text pass over the transcript.
#           Independent, but costs a round trip that overruns the 600ms mic gate,
#           and its own quota.
#
#   full    classify every user final (original behaviour)
#   verify  classify only when the in-band rating is elevated, or every 45s.
#           Keeps independence, cuts classifier volume roughly 10x
#   off     in-band rating only
#
# Only a CONFIRMED imminent rating (two in a row, within 45s) can pause a call.
MINDPAL_VOICE_CLASSIFIER=full

MINDPAL_LLM_PROVIDER=
# Per-path overrides. The classifier is the safety path and has a latency budget
# (the live-voice mic gate caps at 600ms), so it is worth routing separately.
MINDPAL_CHAT_PROVIDER=
MINDPAL_JSON_PROVIDER=
# Tried once when the primary rate-limits. Empty disables the ladder.
# Never fires on a 4xx that is not a 429, and never mid-stream.
MINDPAL_LLM_FALLBACK=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Structured/classifier calls. Falls back to OPENROUTER_MODEL when unset.
# Validate any classifier model with scripts/eval/validate_voice_classifier.py before
# trusting it: a wrong label pauses a healthy call or misses a real one.
OPENROUTER_JSON_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_TITLE=MindPal

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# LLM fallback policy
REQUIRE_REMOTE_LLM_PROVIDER=false
ENABLE_OFFLINE_LLM_FALLBACK=true
ALLOW_OFFLINE_LLM_IN_PRODUCTION=false

# -----------------------------------------------------------------------------
# Firebase Admin / Auth
# Backend uses Firebase Admin SDK, not frontend Firebase client config.
# Use FIREBASE_CREDENTIALS_JSON for Vercel.
# Use FIREBASE_CREDENTIALS_PATH locally if preferred.
# -----------------------------------------------------------------------------

FIREBASE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=

FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

FIREBASE_APP_NAME=mindpal
FIREBASE_USE_APPLICATION_DEFAULT=false
# Check Firebase token revocation on every request. Defaults to true when unset.
# With it off, a user who signs out, or an account that is disabled or
# compromised, keeps working until the ID token happens to expire.
FIREBASE_CHECK_REVOKED_TOKENS=true

# Application data store: firestore | supabase | memory.
# Unset = supabase when configured, else firestore when Firebase Admin
# credentials exist, else memory (local only; logged as an error in production).
# Production uses Supabase: the Firebase project has no Firestore database.
# Move data between providers with scripts/ops/migrate_store.py.
MINDPAL_STORAGE_PROVIDER=supabase
FIRESTORE_DATABASE_ID=default
# Supabase (optional provider; also hosts the feature-policy control plane).
SUPABASE_URL=https://ifezhzuwbdurxkpooblh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Scheduler credential for /api/internal/voice-retention (Vercel Cron sends
# Authorization: Bearer $CRON_SECRET). Either variable is accepted.
CRON_SECRET=
MINDPAL_VOICE_RETENTION_CRON_SECRET=
# Support-only access to redacted voice traces.
MINDPAL_VOICE_SUPPORT_DIAGNOSTICS_SECRET=

# Per-account adaptive learning (style preferences + strategy feedback). 0 disables.
MINDPAL_ADAPTIVE_LEARNING=1
# Pin the platform load level (calm|busy|strained|critical) during incidents.
# Unset = computed live from the platform pulse. See docs/architecture/memory-consolidation-and-load.md
MINDPAL_PRESSURE_OVERRIDE=

# -----------------------------------------------------------------------------
# TTS
# Supported external provider: camb
# Browser fallback is owned by TTSService.
# -----------------------------------------------------------------------------

TTS_PROVIDER_ORDER=camb

CAMB_API_KEY=
CAMB_BASE_URL=https://client.camb.ai/apis
CAMB_SPEECH_MODEL=mars-8.1-flash-beta
CAMB_DEFAULT_VOICE_ID=147320
CAMB_TIMEOUT_SECONDS=45
CAMB_APPLY_ENHANCEMENT=false

REQUIRE_EXTERNAL_TTS_PROVIDER=false
ENABLE_BROWSER_TTS_FALLBACK=true
ALLOW_BROWSER_TTS_IN_PRODUCTION=true
TTS_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# Memory
# -----------------------------------------------------------------------------

MEMORY_SUMMARY_MAX_CHARS=4000
ENABLE_LLM_MEMORY_SUMMARIZATION=true
ALLOW_OFFLINE_LLM_MEMORY_SUMMARIZATION=false

# -----------------------------------------------------------------------------
# Safety
# -----------------------------------------------------------------------------

SAFETY_ENABLED=true
ENABLE_LLM_SAFETY_CLASSIFIER=true
ALLOW_OFFLINE_LLM_SAFETY_CLASSIFIER=false

ENABLE_PERSPECTIVE=false
PERSPECTIVE_API_KEY=

# -----------------------------------------------------------------------------
# Output guard
# -----------------------------------------------------------------------------

ENABLE_LLM_OUTPUT_REWRITE=true
ALLOW_OFFLINE_LLM_OUTPUT_REWRITE=false

# -----------------------------------------------------------------------------
# RAG
# -----------------------------------------------------------------------------

RAG_ENABLED=true
ENABLE_LLM_RAG_PLANNING=true
ENABLE_BUILTIN_RAG_FALLBACK=false
ALLOW_BUILTIN_RAG_FALLBACK_IN_PRODUCTION=false
ALLOW_OFFLINE_LLM_RAG_PLANNER=false

# -----------------------------------------------------------------------------
# Cloudflare Workers AI through AI Gateway
# -----------------------------------------------------------------------------
# Set LLM_PROVIDER_ORDER=cloudflare,openrouter,groq,gemini if you want Cloudflare first.
CF_AIG_TOKEN=
CLOUDFLARE_ACCOUNT_ID=665a8598994b2099ff235fc3779e7531
CLOUDFLARE_GATEWAY_ID=default
CLOUDFLARE_MODEL=workers-ai/@cf/meta/llama-3.1-8b-instruct-fp8-fast
CLOUDFLARE_AI_MODE=gateway_compat

# -----------------------------------------------------------------------------
# Firebase web authentication (browser client)
# -----------------------------------------------------------------------------
# Copy the public Web App configuration values from Firebase Console.
# If FIREBASE_AUTH_DOMAIN is blank, MindPal derives
# <FIREBASE_WEB_PROJECT_ID>.firebaseapp.com; do not use localhost here.
ENABLE_FIREBASE=false
FIREBASE_WEB_API_KEY=
# Public Google OAuth web client ID for Google Identity Services; do not place a client secret here.
FIREBASE_WEB_GOOGLE_CLIENT_ID=
FIREBASE_AUTH_DOMAIN=
# Enable only when /__/auth and /__/firebase are transparently proxied to Firebase Hosting.
FIREBASE_USE_SAME_ORIGIN_AUTH_PROXY=false
FIREBASE_DATABASE_URL=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_APPCHECK_SITE_KEY=
