# -----------------------------------------------------------------------------
# MindPal environment
#
# Every key here is read by the app. tests/backend/api/test_deployment_config.py
# fails if one is not, so a renamed setting cannot silently stop working.
# -----------------------------------------------------------------------------

# development | test | production (the default when unset). Production refuses
# non-durable storage and hides developer-only paths.
ENVIRONMENT=development
DEBUG=true

# Host and origin policy. The app and the API share an origin, so a
# single-origin deployment needs neither of these set.
#
# MINDPAL_ALLOWED_HOSTS: comma-separated hostnames this deployment answers to.
# On Vercel, requests only reach the app through domains assigned to the
# project, so this is only needed when self-hosting behind a generic proxy.
# MINDPAL_ALLOWED_HOSTS=mindpal.example.com,www.mindpal.example.com
#
# MINDPAL_CORS_ORIGINS: exact origins allowed to call the API cross-site. Only
# needed when the web client is served from a different origin. "*" is refused
# at startup — these endpoints carry Authorization headers, and a wildcard
# invites any page to drive them with a token it has phished.
# MINDPAL_CORS_ORIGINS=https://app.mindpal.example.com

# -----------------------------------------------------------------------------
# Feature switches
# -----------------------------------------------------------------------------

# Guests can always chat without signing in (not a setting). They have no
# server-side storage key: chats, profile, insights and memory stay on their
# device until they sign in.

# Live duplex preview. On by default for signed-in accounts. Set to 0 to disable
# (allowlist still works via MINDPAL_VOICE_LIVE_ALLOWLIST). Guests always sign in first.
# MINDPAL_VOICE_LIVE=0
# MINDPAL_VOICE_LIVE_ALLOWLIST=

# Presence surface preview. Off unless explicitly enabled.
# MINDPAL_PRESENCE=1
# MINDPAL_PRESENCE_ALLOWLIST=

# Per-account adaptive learning (style preferences + strategy feedback). 0 disables.
MINDPAL_ADAPTIVE_LEARNING=1
# Embedding search for guidance and past conversations. 0 = keywords only.
MINDPAL_SEMANTIC_SEARCH=1
# Per-turn insight planner: picks the one useful thing a reply adds (a reframe,
# a noticing, a next step...) from the message and the conversation. 0 disables.
MINDPAL_INSIGHT_PLANNER=1
# Pin the platform load level (calm|busy|strained|critical) during incidents.
# Unset = computed live from the platform pulse. See docs/operations.md.
MINDPAL_PRESSURE_OVERRIDE=

# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------

GEMINI_API_KEY=
# Chat model. A stale value here (or in .env.local) changes which model answers users.
GEMINI_MODEL=gemini-2.5-flash
# Safety classifier + other structured JSON calls. Kept separate on purpose: it is
# a different quota pool, so an exhausted chat quota does not take the live-voice
# crisis classifier down with it. Validate any change with
# scripts/eval/validate_voice_classifier.py before shipping it.
GEMINI_JSON_MODEL=gemini-2.5-flash-lite

# Text provider routing: gemini | openrouter | groq. Gemini's quota is one pool
# and only the Live native-audio socket genuinely needs it, so routing text
# elsewhere keeps Gemini for Live and stops a text-quota exhaustion from taking
# the live-voice safety classifier down with it. Default is gemini everywhere.
MINDPAL_LLM_PROVIDER=
# Per-path overrides. The classifier is the safety path and has a latency budget
# (the live-voice mic gate caps at 600ms), so it is worth routing separately.
MINDPAL_CHAT_PROVIDER=
MINDPAL_JSON_PROVIDER=
# The fallback ladder: comma-separated "provider" or "provider:model" entries,
# tried in order when the one before rate-limits, errors with a 5xx/timeout, or
# returns nothing. Never on another 4xx, never mid-stream; a rung that just
# rate-limited is tried last for 20s. Entries without a key are skipped.
# Groq limits per model, so a second Groq model is free extra capacity.
# Example: groq:openai/gpt-oss-120b,openrouter,gemini
MINDPAL_LLM_FALLBACK=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Structured/classifier calls. Falls back to OPENROUTER_MODEL when unset.
# Validate any classifier model with scripts/eval/validate_voice_classifier.py before
# trusting it: a wrong label pauses a healthy call or misses a real one.
OPENROUTER_JSON_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_TITLE=MindPal

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_JSON_MODEL=
# Composer dictation (speech to text, any language). Falls back to Gemini when unset/failing.
GROQ_STT_MODEL=whisper-large-v3-turbo

# More OpenAI-compatible providers with free tiers (inert until a key is set;
# add them to MINDPAL_LLM_FALLBACK to use them). Model ids drift; override here.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# -----------------------------------------------------------------------------
# Live-voice safety: two detectors, one state machine
#
# in-band   The Live model rates the caller itself via the `report_risk` tool.
#           Hears prosody, crying, hesitation - none of which survives ASR - and
#           costs no latency or quota. Always on. NOT independent: the model
#           grading the call is the model running it.
# classifier An independent text pass over the transcript. Independent, but
#           costs a round trip and its own quota.
#
#   full    classify every user final (original behaviour)
#   verify  classify only when the in-band rating is elevated, or every 45s.
#           Keeps independence, cuts classifier volume roughly 10x
#   off     in-band rating only
#
# Only a CONFIRMED imminent rating (two in a row, within 45s) can pause a call.
# -----------------------------------------------------------------------------
MINDPAL_VOICE_CLASSIFIER=full

# -----------------------------------------------------------------------------
# Firebase Admin / Auth (backend)
# Use FIREBASE_CREDENTIALS_JSON for Vercel, FIREBASE_CREDENTIALS_PATH locally.
# -----------------------------------------------------------------------------

FIREBASE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=

FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

FIREBASE_APP_NAME=mindpal
FIREBASE_USE_APPLICATION_DEFAULT=false
# Check Firebase token revocation on every request. Defaults to true when unset.
# A revoked, disabled or deleted account is refused; only an unreachable
# identity service lets a locally verified token through.
FIREBASE_CHECK_REVOKED_TOKENS=true

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------

# Application data store: supabase | firestore | memory.
# Unset = supabase when configured, else firestore when Firebase Admin
# credentials exist, else memory. Memory is refused in production: the app
# starts with data routes answering 503 until durable storage is configured.
# Move data between providers with scripts/ops/migrate_store.py.
MINDPAL_STORAGE_PROVIDER=supabase
FIRESTORE_DATABASE_ID=default
SUPABASE_URL=https://ifezhzuwbdurxkpooblh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Scheduler credential for /api/internal/* jobs (voice retention, memory
# consolidation). Vercel Cron sends Authorization: Bearer $CRON_SECRET.
# Either variable is accepted.
CRON_SECRET=
MINDPAL_VOICE_RETENTION_CRON_SECRET=
# Support-only access to redacted voice traces.
MINDPAL_VOICE_SUPPORT_DIAGNOSTICS_SECRET=

# -----------------------------------------------------------------------------
# Firebase web authentication (browser client)
# -----------------------------------------------------------------------------
# Copy the public Web App configuration values from Firebase Console.
# If FIREBASE_AUTH_DOMAIN is blank, MindPal derives
# <FIREBASE_WEB_PROJECT_ID>.firebaseapp.com; do not use localhost here.
ENABLE_FIREBASE=false
FIREBASE_WEB_API_KEY=
# Public Google OAuth web client ID for Google Identity Services; do not place a client secret here.
FIREBASE_WEB_GOOGLE_CLIENT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_APPCHECK_SITE_KEY=
